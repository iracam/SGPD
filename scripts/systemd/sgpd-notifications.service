# Varredura de prazos e despacho da fila de notificações (ADR-049).
#
# Acionado por sgpd-notifications.timer. A varredura é idempotente: rodar com
# mais frequência muda a latência do aviso, nunca a quantidade.

[Unit]
Description=SGPD — varredura e despacho da fila de notificações
After=network-online.target sgpd-web.service

[Service]
Type=oneshot
User=macari
Group=macari
WorkingDirectory=/home/macari/prd/SGPD
ExecStart=/home/macari/prd/SGPD/.venv/bin/python manage.py sgpd_scan_notifications --dispatch

# Sem ProtectHome: a aplicação está dentro de /home (ver sgpd-web.service).
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

# Application
APP_ENV=development
# `config.settings.production` no host publicado atrás do proxy corporativo;
# esse módulo recusa subir com DJANGO_DEBUG ligado.
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_DEBUG=true
# Gere com `python -c "import secrets; print(secrets.token_urlsafe(64))"`. Além
# de assinar sessões, deriva a cifra dos segredos da central de configurações:
# trocá-la exige reinformar as senhas de bind do AD e do SMTP.
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
DJANGO_TIME_ZONE=America/Sao_Paulo
LOG_LEVEL=INFO
# Quantos proxies confiáveis estão à frente da aplicação. 0 sem proxy; 1 atrás
# de um proxy que anexa X-Forwarded-For. Errar para mais deixa o cliente forjar
# o próprio endereço e escapar do limite de tentativas de login.
DJANGO_NUM_PROXIES=0
# Django Admin somente leitura (ADR-025). Desligue onde a aplicação está
# publicada: o login dele não passa pelo limite de tentativas do DRF.
DJANGO_ADMIN_ENABLED=true

# Static files (WhiteNoise; do not use for evidence uploads)
WHITENOISE_AUTOREFRESH=true
WHITENOISE_USE_FINDERS=true

# SGPD Oracle database (DEV exception: SGPD is both owner and runtime user)
# This connection also reads the explicitly granted VETORH objects in the same database.
SGPD_DB_NAME=
SGPD_DB_USER=SGPD
SGPD_DB_PASSWORD=
SGPD_DB_CONN_MAX_AGE=60
SENIOR_QUERY_TIMEOUT_MS=5000
SENIOR_QUERY_MAX_PAGE_SIZE=100

# Limite de tentativas de login, contado por origem e usuário alvo.
LOGIN_THROTTLE_RATE=10/min
TNS_ADMIN=
ORACLE_CLIENT_LIB_DIR=/opt/oracle/instantclient_19_28

# Redis and asynchronous jobs (optional container, enabled when required)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# SMTP — baseline do primeiro boot (ADR-050).
# O que vale em execução é a central em /fe/configuracoes/email; estas variáveis
# só governam enquanto ninguém tiver salvo a configuração pela interface.
# Microsoft 365 SMTP submission. Set user, password and sender in the real .env.
EMAIL_HOST=smtp.office365.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_TIMEOUT_SECONDS=10
DEFAULT_FROM_EMAIL=

# Notificações (ADR-049): fila no Oracle, despacho por comando agendado.
# Também baseline: a central sobrescreve todos os valores abaixo (ADR-050).
# SGPD_BASE_URL compõe os links das mensagens; vazio produz link relativo.
SGPD_BASE_URL=
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_BATCH_SIZE=50
NOTIFICATION_STALE_MINUTES=15
# Marcos de prazo, em horas (WORKFLOWS.md §7).
NOTIFICATION_TASK_DUE_SOON_HOURS=48
NOTIFICATION_TASK_DUE_IMMINENT_HOURS=24
NOTIFICATION_TASK_CRITICAL_HOURS=48
NOTIFICATION_PROCESS_DUE_SOON_HOURS=72

# Active Directory (discovery and authentication share the same transport)
LDAP_ENABLED=false
LDAP_AUTHENTICATION_ENABLED=false
LDAP_SERVER_ADDRESS=ad.example.internal
# true monta LDAPS automaticamente; false usa LDAP simples com warning permanente.
LDAP_USE_TLS=true
# Com TLS, instale/informe a CA em vez de desabilitar validação.
LDAP_TLS_REQUIRE_CERTIFICATE=true
LDAP_TLS_CA_CERT_FILE=
# Prefer an unprivileged read-only service account in UPN or full DN format.
LDAP_BIND_DN=svc.sgpd@example.internal
LDAP_BIND_PASSWORD=
# Discovery may leave bases empty and use defaultNamingContext from RootDSE.
# Authentication requires LDAP_USER_SEARCH_BASE. Prefer a restricted OU.
# Example: OU=Usuarios,OU=Corporativo,DC=example,DC=internal.
LDAP_USER_SEARCH_BASE=
LDAP_GROUP_SEARCH_BASE=
# Optional: require direct/nested membership in one group for discovery and login.
LDAP_REQUIRED_GROUP_DN=
LDAP_NESTED_GROUP_SEARCH=true
# Optional fixed administrative LDAP filter, already enclosed in parentheses.
LDAP_USER_EXTRA_FILTER=
LDAP_CONNECT_TIMEOUT_SECONDS=5
LDAP_RECEIVE_TIMEOUT_SECONDS=10
LDAP_PAGE_SIZE=100
LDAP_RESULT_LIMIT=50
# Linked common accounts never fall back to local auth. Keep one local superuser.
LDAP_LOCAL_SUPERUSER_FALLBACK=true

# Private assets uploaded from the SuperAdmin configuration area.
SYSTEM_CONFIGURATION_STORAGE_PATH=media/system-configuration

# Manuais operacionais servidos em /ajuda/<slug>/ (ADR-053). O padrão é o
# próprio diretório do repositório; os arquivos saem de `node docs/operacao/build.mjs`.
OPERATION_MANUALS_DIR=docs/operacao

# Evidence storage
EVIDENCE_STORAGE_BACKEND=filesystem
EVIDENCE_STORAGE_PATH=media/evidence
EVIDENCE_MAX_UPLOAD_BYTES=10485760
S3_ENDPOINT_URL=
S3_BUCKET_NAME=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION_NAME=

# Transport e sessão. Com HTTPS na borda — inclusive quando o TLS termina num
# proxy — ligue as duas flags; em HTTP puro o navegador descarta o cookie e o
# login para de funcionar.
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
# Expiração de sessão por inatividade, em segundos.
SESSION_COOKIE_AGE=28800
# Só em config.settings.production: idade do HSTS anunciado pela aplicação.
# Comece baixo e suba depois de confirmar que o domínio fica em HTTPS.
SECURE_HSTS_SECONDS=3600
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
